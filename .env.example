# Copy to .env for local use; on a host, set these as environment variables. All are optional.
# See docs/deploy.md for what each one does.

# --- Keys for live data ---
# WSDOT Traveler Information API access code (https://wsdot.wa.gov/traffic/api/)
WSDOT_CODE=
# Oregon DOT TripCheck API subscription key (https://apiportal.odot.state.or.us/)
ORDOT_CODE_PRIMARY=
# Idaho 511 developer key (https://511.idaho.gov/developers/doc): Idaho pass reports, closures and road temperatures
ID_511_DOT_API_KEY=
# Nevada 511 developer key (https://www.nvroads.com/developers/doc): Nevada chain controls and closures
NV_511_DOT_API_KEY=
# Windy Webcams API key (https://api.windy.com/keys)
WINDY_API_KEY=
# YouTube Data API v3 key, restricted to that API (https://console.cloud.google.com/apis/credentials)
YOU_TUBE_DATA_API_KEY=
# Optional routing and place search with live traffic; without it the free services are used
AZURE_MAPS_KEY=
# GitHub token (Issues: read and write, this repository only) so the Add a camera form can file suggestions
GITHUB_ISSUES_TOKEN=

# --- Hosting (usually only on a server) ---
# How many X-Forwarded-For entries your proxies add
TRUSTED_PROXIES=
# Your main address, e.g. example.com; other addresses forward there
CANONICAL_HOST=
# Where visit counts are saved (a disk that survives restarts)
STATS_FILE=
# Where shared before-and-after pictures are saved (default: next to STATS_FILE)
MOMENTS_DIR=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codingwithchad/whatsupahead/schema/pass.schema.json",
  "title": "Mountain pass",
  "description": "A mountain pass with a live report: WSDOT's pass reports (Washington), ODOT's crew road reports (Oregon) or Caltrans chain controls and closures (California).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "route",
    "connects",
    "group",
    "lat",
    "lon",
    "place"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "pass_id": {
      "type": "integer",
      "description": "WSDOT's MountainPassId (Washington passes)."
    },
    "route": {
      "type": "string"
    },
    "connects": {
      "type": "string",
      "description": "Which towns the pass connects."
    },
    "group": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "elevation_ft": {
      "type": "number"
    },
    "place": {
      "type": "string",
      "description": "Id of the place page showing this pass's cameras and weather."
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "route"
      ],
      "description": "Oregon, California and Idaho passes: which state feed the report comes from.",
      "properties": {
        "source": {
          "enum": [
            "odot",
            "caltrans",
            "itd"
          ]
        },
        "route": {
          "type": "string",
          "description": "The highway as the feed writes it, e.g. US20 (ODOT), SR-89 (Caltrans) or I-90 (ITD)."
        },
        "radius_km": {
          "type": "number",
          "description": "How far from the summit to use reports (default 15)."
        },
        "districts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "description": "Caltrans districts to fetch."
        },
        "closures": {
          "type": "boolean",
          "description": "Also check Caltrans's lane-closure list for full closures (default true)."
        },
        "station": {
          "type": "string",
          "description": "Idaho: the summit weather station, by the camera id Idaho 511's pass list gives it (e.g. 246.C1)."
        }
      }
    },
    "winter_closure": {
      "type": "string",
      "description": "For roads that close for the winter: when, in words."
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "pass_id"
      ]
    },
    {
      "required": [
        "report"
      ]
    }
  ]
}
